{
  "compilerOptions": {
    "strict": true,
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "lib": ["ES2020", "DOM"],
    "outDir": "dist",
    "baseUrl": "."
  },
  "include": ["src/**/*.ts", "tests/**/*.ts", "experiments/**/*.ts"]
}
