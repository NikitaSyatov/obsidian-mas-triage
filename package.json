{
  "name": "obsidian-mas-triage",
  "version": "0.0.1",
  "description": "MAS vs SAS triage skeleton for Obsidian",
  "main": "main.js",
  "scripts": {
    "build": "node esbuild.config.mjs",
    "dev": "node esbuild.config.mjs --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "obsidian",
    "multi-agent",
    "triage"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.11.0",
    "esbuild": "^0.20.0",
    "obsidian": "^1.5.0",
    "openai": "^4.28.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.0",
    "vitest": "^1.3.0"
  }
}
